<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job for the externally supervised agent (macOS). This is the ONE job definition:
  install.sh ships this exact file inside the release archive and places it, so a
  node bootstrapped by the installer and one set up by hand run the same daemon.
  Installing it by hand:

      sudo cp dev.updated.agent.plist /Library/LaunchDaemons/
      sudo launchctl bootstrap system /Library/LaunchDaemons/dev.updated.agent.plist

  launchd manages the installer-owned agent directly. Agent binary upgrades are ordinary package
  or configuration-management operations; launchd starts the replacement bytes. The agent invokes
  each release's own reconciler hooks. The lifecycle hierarchy terminates at launchd:

    launchd =manages=> agent =invokes=> release hooks
       package manager =replaces=> agent

  KeepAlive restarts the agent whenever it exits. Workload processes belong to each release's
  reconciler hooks, never to the agent.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.updated.agent</string>

  <!-- This is a system LaunchDaemon and deliberately runs as root. A configuration reconciler
       must be able to manage the whole machine and honor the agent's fixed reboot action. Signed
       provider artifacts and the pinned TUF root are the authorization boundary for that
       privileged code. -->

  <key>ProgramArguments</key>
  <array>
    <string>/etc/updated/updated-agent</string>
    <string>--config</string>
    <string>/etc/updated/config.toml</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>UPDATED_STATE_DIR</key>
    <string>/usr/local/var/updated</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
