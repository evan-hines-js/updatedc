# systemd unit for the self-updating agent (Linux). This is the ONE unit definition:
# the `updated-agent` .deb/.rpm ships this exact file, install.sh places this exact
# file from the release archive, and the Ansible role installs either that package or
# that same archived file — it templates no copy of its own, so a node can never run a
# unit that did not ship with the binaries it is running.
# Tune it through /etc/updated/agent.env (see below), not by forking it.
#
# Installing it by hand, if you are not using a package:
#
#   install -m0644 updated-agent.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now updated-agent
#
# systemd manages the lifecycle of the tiny, installer-owned LAUNCHER (launcher).
# The launcher runs the committed agent pointer and advances it only after a
# content-addressed candidate proves it can run; the agent deploys releases by
# invoking each release's own reconciler hooks. Workload processes belong to the
# hooks (typically their own systemd units), never to the launcher or the agent,
# so this unit's restarts can never disturb a workload:
#
#   systemd --manages--> launcher --activates--> agent --invokes--> release hooks
#                            |
#                      pointer-swaps the agent (readiness-gated); never itself
#
#     package manager --replaces--> launcher/agent   (out-of-band alternative)
#
# The launcher runs continuously: when the agent stages a self-update and exits,
# the launcher (not systemd) activates the candidate under a readiness gate,
# committing its path or retaining the previous pointer. systemd only relaunches
# the launcher itself, on the rare event that it crashes.

[Unit]
Description=Self-updating release agent (via launcher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The launcher is installer-owned and read-only; it never updates itself, so it
# lives outside the writable state directory. The initial agent is installer-owned;
# later verified candidates live content-addressed under the state directory.
#
# No --agent-config: the launcher reads the canonical /etc/updated/config.toml.
# Pass it only if this deployment puts the config somewhere else.
#
# The defaults below are the unit's own, so the unit is complete on its own; the
# optional environment file overrides them. That is the one place to widen
# --ready-timeout for a fleet whose first cold install pulls a large bundle over a
# slow link — editing a conf file, never a second copy of this unit.
Environment=UPDATED_STATE_DIR=/var/lib/updated
Environment=UPDATED_AGENT=/usr/lib/updated/updated-agent
Environment=UPDATED_READY_TIMEOUT=60
Environment=UPDATED_CONFIRM_TIMEOUT=30
EnvironmentFile=-/etc/updated/agent.env
ExecStart=/usr/lib/updated/updated-launcher --state-dir ${UPDATED_STATE_DIR} --agent ${UPDATED_AGENT} --ready-timeout ${UPDATED_READY_TIMEOUT} --confirm-timeout ${UPDATED_CONFIRM_TIMEOUT}

# Relaunch the launcher if it ever crashes. The start-limit defaults stop a
# crash-looping build after a few tries.
Restart=always
RestartSec=2

# Signal only the launcher first; it coordinates a clean agent shutdown. If that
# coordination wedges, mixed mode kills every residual process in this service's
# cgroup after TimeoutStopSec instead of leaving an orphan agent updating in the
# background. Workloads live in separate units and are not members of this cgroup.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Configuration management is intentionally machine-wide. The signed reconciler may manage users,
# packages, services, mounts, networking, the boot loader, and any other host state, and the agent
# must also be able to honor its own fixed reboot action. This system service therefore runs as
# root. The TUF and provider signatures are the authorization boundary for privileged code.
StateDirectory=updated
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
