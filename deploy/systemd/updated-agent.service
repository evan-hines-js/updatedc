# systemd unit for the externally supervised agent (Linux). This is the ONE unit definition:
# the `updated-agent` .deb/.rpm ships this exact file, install.sh places this exact
# file from the release archive, and the Ansible role installs either that package or
# that same archived file — it templates no copy of its own, so a node can never run a
# unit that did not ship with the binaries it is running.
# Tune it through /etc/updated/agent.env (see below), not by forking it.
#
# Installing it by hand, if you are not using a package:
#
#   install -m0644 updated-agent.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now updated-agent
#
# systemd manages the lifecycle of the installer-owned agent directly. Agent binary upgrades are
# ordinary package/configuration-management operations; systemd restarts the service onto the new
# bytes. The agent deploys releases by invoking each release's own reconciler hooks. Workload
# processes belong to those hooks (typically their own systemd units), never to the agent,
# so this unit's restarts can never disturb a workload:
#
#   systemd --manages--> agent --invokes--> release hooks
#        ^
#   package manager --replaces--> agent

[Unit]
Description=Updated release agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# The package-owned binary is read-only. Persistent enrollment, identity, and update transaction
# state live in StateDirectory; the optional environment file may relocate either path.
Environment=UPDATED_STATE_DIR=/var/lib/updated
Environment=UPDATED_CONFIG=/etc/updated/config.toml
EnvironmentFile=-/etc/updated/agent.env
ExecStart=/usr/lib/updated/updated-agent --config ${UPDATED_CONFIG}

# Relaunch the agent when it exits, including after certificate renewal or a boot-recovery handoff.
Restart=always
RestartSec=2

# Workloads live in separate units and are not members of this cgroup.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Configuration management is intentionally machine-wide. The signed reconciler may manage users,
# packages, services, mounts, networking, the boot loader, and any other host state, and the agent
# must also be able to honor its own fixed reboot action. This system service therefore runs as
# root. The TUF and provider signatures are the authorization boundary for privileged code.
StateDirectory=updated
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
