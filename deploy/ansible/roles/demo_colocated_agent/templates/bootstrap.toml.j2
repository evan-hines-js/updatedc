[enrollment]
url = "{{ demo_enrollment_url | default('https://updatec-gateway') }}"
# This node's self-asserted enrollment name — the gateway creates the UpdateAgent object under
# exactly this string. The demo layer addresses the manual Magnolia node by the sha-derived resource
# name it computes from `demo_colocated_hostname`, so `updated_hostname` defaults to that same
# derivation (see this role's defaults) and is the only variable that reaches the name.
name = "{{ updated_hostname }}"
client_cert = "/etc/updated/agent-tls/tls.crt"
client_key = "/etc/updated/agent-tls/tls.key"
ca = "/etc/updated/agent-tls/ca.crt"
