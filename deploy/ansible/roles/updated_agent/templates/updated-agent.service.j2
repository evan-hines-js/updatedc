[Unit]
Description=updated agent (launcher)
# Only the socat-shim demo has a unit to wait for; a production install has none.
After=network-online.target{{ ' updated-gateway-shim.service' if updated_demo_shim_host is defined else '' }}
Wants=network-online.target

[Service]
# No --agent-config: the launcher reads the canonical /etc/updated/config.toml,
# which this role installs.
ExecStart=/usr/local/bin/updated-launcher \
  --state-dir /var/lib/updated/launcher \
  --agent /usr/local/bin/updated-agent \
  --ready-timeout 900 --confirm-timeout 5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
