[Unit]
Description=updated agent (bootstrap guardian)
After=network-online.target updated-gateway-shim.service
Wants=network-online.target

[Service]
# No --supervisor-config: the bootstrap reads the canonical /etc/updated/bootstrap.toml,
# which this role installs.
ExecStart=/usr/local/bin/bootstrap \
  --state-dir /var/lib/updated/guardian \
  --supervisor /usr/local/bin/supervisor \
  --ready-timeout 900 --confirm-timeout 5 \
  --probe-address 0.0.0.0:9090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
