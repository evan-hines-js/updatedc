#!/usr/bin/env bash
set -euo pipefail

# Package entrypoint. The runtime supplies optional context through environment variables;
# this script contains only HAProxy-specific machine-state policy.
#
# The agent never touches a workload process, so this reconciler owns the HAProxy process outright.
# `converge` starts the payload when no master of ours is running and re-execs the live master in
# place when one is — see `converge_release`. Recovery explicitly restores the prior release.

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/haproxy/lib.sh
source "$here/lib.sh"

operation=${UPDATED_OPERATION:?}
attempt=${UPDATED_ATTEMPT_ID:?}
root=${UPDATED_INSTALL_ROOT:?}
payload=${UPDATED_PAYLOAD_ROOT:?}
result_file=${UPDATED_RESULT_FILE:?}
state_dir=${UPDATED_STATE_DIR:?}
backup="$state_dir/before-${attempt%r}"
mkdir -p "$state_dir"
runtime="$root/runtime"

publish_result() {
  local changed=$1
  [[ -n $result_file ]] || die "missing --result-file"
  printf '{"schema":1,"status":"succeeded","changed":%s,"hostAction":"none","message":null}' \
    "$changed" >"$result_file"
}

audit "$root" "$operation" "$attempt" started

case "$operation" in
  converge)
    if [[ ! -f $backup ]]; then
      cat "$runtime/live-release.path" 2>/dev/null >"$backup.tmp" || true
      mv "$backup.tmp" "$backup"
    fi
    changed=true
    if live_master "$runtime" && [[ $(cat "$runtime/live-release.path" 2>/dev/null || true) == "$payload" ]]; then
      changed=false
    fi
    [[ -x "$payload/bin/haproxy" ]] || die "payload $payload has no executable bin/haproxy"
    "$payload/bin/haproxy" -c -f "$payload/config/haproxy.cfg" >/dev/null \
      || die "payload HAProxy configuration failed validation"
    converge_release "$payload" "$root"
    publish_result "$changed"
    ;;
  rollback)
    previous=$(cat "$backup" 2>/dev/null || true)
    if [[ -n $previous ]]; then converge_release "$previous" "$root"; fi
    publish_result true
    ;;
  healthcheck)
    # The agent owns no workload process, so a running, identified master under the runtime pid
    # file is the whole of "healthy" — before the first upgrade as much as after one.
    [[ -f "$runtime/haproxy.cfg" ]] || die "stable runtime configuration is missing"
    live_master "$runtime" || die "no HAProxy master is running"
    [[ $(cat "$runtime/live-release.path") == "$payload" ]] || die "wrong release is running"
    ;;
  inspect)
    [[ -f "$runtime/haproxy.cfg" ]] || die "stable runtime configuration is missing"
    printf 'runtime-config=%s\n' "$(cksum <"$runtime/haproxy.cfg")"
    ;;
  *)
    die "unknown reconciler operation '$operation'"
    ;;
esac

audit "$root" "$operation" "$attempt" completed
