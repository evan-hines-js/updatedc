#!/usr/bin/env bash
set -euo pipefail

# Signed HAProxy node reconciler. The agent supplies the operation and context as ordinary argv;
# this script contains only HAProxy-specific machine-state policy.
#
# The agent never touches a workload process, so this reconciler owns the HAProxy process outright.
# `apply` (and `rollback`) start the release when no master of ours is running and re-exec the live
# master in place when one is — see `converge_release`.

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/haproxy/lib.sh
source "$here/lib.sh"

operation=${1:?missing reconciler operation}
shift

protocol=
attempt=unknown
root=
candidate=
predecessor=

while (($#)); do
  case "$1" in
    --protocol) protocol=$2; shift 2 ;;
    --attempt-id) attempt=$2; shift 2 ;;
    --reason) shift 2 ;;
    --install-root) root=$2; shift 2 ;;
    --candidate) candidate=$2; shift 2 ;;
    # This reconciler keeps no cross-invocation state of its own: HAProxy's own runtime
    # tree under `--install-root` is the whole state. Accept and discard the agent's
    # scratch directory.
    --state-dir) shift 2 ;;
    --candidate-version) shift 2 ;;
    --input-file | --output-file) shift 2 ;;
    --predecessor) predecessor=$2; shift 2 ;;
    --predecessor-version) shift 2 ;;
    --) shift; break ;;
    *) die "unknown reconciler argument '$1'" ;;
  esac
done

[[ $protocol == 1 ]] || die "unsupported reconciler protocol '$protocol'"
[[ -n $root ]] || die "missing --install-root"
runtime="$root/runtime"

audit "$root" "$operation" "$attempt" started

case "$operation" in
  apply)
    [[ -x "$candidate/bin/haproxy" ]] || die "candidate $candidate has no executable bin/haproxy"
    "$candidate/bin/haproxy" -c -f "$candidate/config/haproxy.cfg" >/dev/null \
      || die "candidate HAProxy configuration failed validation"
    converge_release "$candidate" "$root"
    ;;
  rollback)
    converge_release "$predecessor" "$root"
    ;;
  healthcheck)
    # The agent owns no workload process, so a running, identified master under the runtime pid
    # file is the whole of "healthy" — before the first upgrade as much as after one.
    [[ -f "$runtime/haproxy.cfg" ]] || die "stable runtime configuration is missing"
    live_master "$runtime" || die "no HAProxy master is running"
    ;;
  inspect)
    [[ -f "$runtime/haproxy.cfg" ]] || die "stable runtime configuration is missing"
    printf 'runtime-config=%s\n' "$(cksum <"$runtime/haproxy.cfg")"
    ;;
  *)
    die "unknown reconciler operation '$operation'"
    ;;
esac

audit "$root" "$operation" "$attempt" completed
