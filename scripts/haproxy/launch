#!/usr/bin/env bash
set -euo pipefail

# Start entrypoint (bin/launch) for an HAProxy node.
#
# The agent starts no workload process, so the signed
# lifecycle provider runs this launcher whenever no master of ours is running (the first deployment
# on a node, or one whose master is gone). Every later upgrade is the provider making THIS master
# re-exec in place (SIGUSR2), so this script runs once per master, not once per release.
#
# It projects the release it ships in onto the stable runtime paths and leaves a detached
# master-worker behind under the stable pid file — detached because the provider invocation that
# starts it must return, and the master must outlive it.
#
# Self-contained on purpose: the application bundle carries no dependency on the separately signed
# provider bundle, so the projection is inlined here rather than sourced.

release="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="${UPDATED_INSTALL_ROOT:?UPDATED_INSTALL_ROOT is required}/runtime"
mkdir -p "$runtime"

bin_tmp="$runtime/.haproxy.$$"
cfg_tmp="$runtime/.haproxy.cfg.$$"
trap 'rm -f "$bin_tmp" "$cfg_tmp"' EXIT
cp "$release/bin/haproxy" "$bin_tmp" && chmod 0755 "$bin_tmp"
cp "$release/config/haproxy.cfg" "$cfg_tmp" && chmod 0644 "$cfg_tmp"
mv -f "$bin_tmp" "$runtime/haproxy"
mv -f "$cfg_tmp" "$runtime/haproxy.cfg"
trap - EXIT

# No master of ours is running, so any pid file here outlived the master that wrote it: remove it
# rather than race the check below against a stale number.
rm -f "$runtime/haproxy.pid"
# -W master-worker, -D background (the master detaches into its own session and keeps running after
# this script and the provider invocation that ran it exit), -p the stable pid file the provider
# reads to signal the master. The master keeps that PID across every future re-exec.
"$runtime/haproxy" -W -D -f "$runtime/haproxy.cfg" -p "$runtime/haproxy.pid"

# Backgrounding means HAProxy's own startup failures land after this returns, so do not report a
# start that did not happen: wait, bounded, for the master to actually be running.
for _ in $(seq 1 100); do
  if [[ -s "$runtime/haproxy.pid" ]] && kill -0 "$(<"$runtime/haproxy.pid")" 2>/dev/null; then
    exit 0
  fi
  sleep 0.1
done
echo "haproxy-launch: no HAProxy master was running 10s after starting it" >&2
exit 1
