# Built on UBI like the shipped images, so one toolchain and one C library produce every binary
# this repository ships. The RUNTIME below stays vanilla Ubuntu deliberately — see its comment —
# and that pairing is safe in this direction only: UBI 9 is glibc 2.34 and Ubuntu 22.04 is 2.35, so
# these binaries run there, while the reverse (bookworm's 2.36 onto UBI) would not start at all.
FROM registry.access.redhat.com/ubi9/ubi@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS build

# `aws-lc-sys` builds its C sources with cmake; `zstd-sys` and `ring` need a C compiler.
COPY --chmod=0755 scripts/install-ubi-build-dependencies.sh /usr/local/bin/install-ubi-build-dependencies
RUN /usr/local/bin/install-ubi-build-dependencies

# The toolchain comes from the workspace's `rust-toolchain.toml`, never from a version named here.
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --default-toolchain none --profile minimal

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo ./.cargo
COPY crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p agent -p server -p sampleapp -p updatec-e2e -p demo-lifecycle -p updated-healthproxy -p updatectl && \
    cp /src/target/release/updated-agent /out-agent && \
    cp /src/target/release/server /out-server && \
    cp /src/target/release/sampleapp /out-sampleapp && \
    cp /src/target/release/updatec-e2e /out-updatec-e2e && \
    cp /src/target/release/demo-lifecycle /out-demo-lifecycle && \
    cp /src/target/release/updated-healthproxy /out-updated-healthproxy && \
    cp /src/target/release/updatectl /out-updatectl && \
    cp /src/target/release/stateful-like /out-stateful-like

# Raw Ubuntu + our node stack, nothing else. Every workload — the sample app, or a real
# Jenkins — is installed INTO this vanilla container at runtime by a signed release and started by
# that release's own reconciler, never baked into a bespoke image. `curl`/`unzip` are ordinary
# base tooling a runtime installer uses; the JRE and Jenkins are not here.
FROM ubuntu:22.04@sha256:3b06811b2afd352be909dd088a004166d665dc76d38b13eada33522a9d915c6f
# `haproxy` is an ordinary distro package here so the release-server can copy the binary into a
# signed bundle and every agent (same base image, so the shared libs are present) can run it after
# `updated` installs it — the load balancer is managed exactly like any other release, not baked
# into a bespoke image. curl/unzip are the same generic runtime-installer tooling.
# Jenkins uses Java's font manager even in headless mode; a bare Ubuntu image has no fonts.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip haproxy fontconfig fonts-dejavu-core tini && \
    rm -rf /var/lib/apt/lists/* && useradd --uid 65532 --create-home updated
COPY --from=build /out-agent /usr/local/bin/updated-agent
COPY --from=build /out-server /usr/local/bin/server
COPY --from=build /out-sampleapp /usr/local/bin/sampleapp
COPY --from=build /out-updatec-e2e /usr/local/bin/updatec-e2e
COPY --from=build /out-demo-lifecycle /usr/local/bin/demo-lifecycle
COPY --from=build /out-updated-healthproxy /usr/local/bin/updated-healthproxy
COPY --from=build /out-updatectl /usr/local/bin/updatectl
COPY --from=build /out-stateful-like /usr/local/bin/stateful-like
COPY crates/updatec/e2e/release-server.sh /usr/local/bin/release-server
COPY crates/updatec/e2e/agent.sh /usr/local/bin/run-agent
COPY scripts/lib/publish-fuzz-plan.sh /usr/local/lib/publish-fuzz-plan.sh
# The jenkins product's entrypoint and its install reconciler — published into the
# release repo by release-server and downloaded by the agent at runtime, never baked into a
# node image (the node is plain Ubuntu + agent; Jenkins itself is installed at runtime).
COPY crates/updatec/e2e/jenkins/app.sh /usr/local/share/jenkins/app.sh
COPY crates/updatec/e2e/jenkins/install.sh /usr/local/share/jenkins/install.sh
# The HAProxy reconciler (a clean bash state machine) and its entrypoint — published into the
# release repo by release-server and downloaded at runtime, never a bespoke image. This is the same
# reexec provider proven by scripts/linux-haproxy-e2e.sh.
COPY scripts/haproxy/lifecycle /usr/local/share/haproxy/lifecycle
COPY scripts/haproxy/lib.sh /usr/local/share/haproxy/lib.sh
COPY scripts/haproxy/launch /usr/local/share/haproxy/launch
RUN chmod 0755 /usr/local/bin/release-server /usr/local/bin/run-agent \
    /usr/local/share/haproxy/lifecycle /usr/local/share/haproxy/launch
USER 65532
ENTRYPOINT ["/usr/local/bin/updated-healthproxy"]
