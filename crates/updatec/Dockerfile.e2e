FROM rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release -p bootstrap -p supervisor -p server -p sampleapp -p updatec-demo -p demo-lifecycle -p updated-healthproxy -p updatectl && \
    cp /src/target/release/bootstrap /out-bootstrap && \
    cp /src/target/release/supervisor /out-supervisor && \
    cp /src/target/release/server /out-server && \
    cp /src/target/release/sampleapp /out-sampleapp && \
    cp /src/target/release/updatec-demo /out-updatec-demo && \
    cp /src/target/release/demo-lifecycle /out-demo-lifecycle && \
    cp /src/target/release/updated-healthproxy /out-updated-healthproxy && \
    cp /src/target/release/updatectl /out-updatectl && \
    cp /src/target/release/stateful-like /out-stateful-like

# Raw Ubuntu + our agent, nothing else. Any managed application — the sample app, or a real
# Jenkins — is installed INTO this vanilla container at runtime by the update/lifecycle
# mechanism, never baked into a bespoke image. `curl`/`unzip` are ordinary base tooling a
# runtime installer uses; the JRE and Jenkins are not here.
FROM ubuntu:22.04
# `haproxy` is an ordinary distro package here so the release-server can copy the binary into a
# signed bundle and every agent (same base image, so the shared libs are present) can run it after
# `updated` installs it — the load balancer is managed exactly like any other release, not baked
# into a bespoke image. curl/unzip are the same generic runtime-installer tooling.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip haproxy && \
    rm -rf /var/lib/apt/lists/* && useradd --uid 65532 --create-home updated
COPY --from=build /out-bootstrap /usr/local/bin/bootstrap
COPY --from=build /out-supervisor /usr/local/bin/supervisor
COPY --from=build /out-server /usr/local/bin/server
COPY --from=build /out-sampleapp /usr/local/bin/sampleapp
COPY --from=build /out-updatec-demo /usr/local/bin/updatec-demo
COPY --from=build /out-demo-lifecycle /usr/local/bin/demo-lifecycle
COPY --from=build /out-updated-healthproxy /usr/local/bin/updated-healthproxy
COPY --from=build /out-updatectl /usr/local/bin/updatectl
COPY --from=build /out-stateful-like /usr/local/bin/stateful-like
COPY crates/updatec/e2e/release-server.sh /usr/local/bin/release-server
COPY crates/updatec/e2e/agent.sh /usr/local/bin/run-agent
COPY scripts/lib/publish-fuzz-plan.sh /usr/local/lib/publish-fuzz-plan.sh
# The jenkins product's launcher and its install reconciler — published into the
# release repo by release-server and downloaded by the agent at runtime, never baked into a
# node image (the node is plain Ubuntu + agent; Jenkins itself is installed at runtime).
COPY crates/updatec/e2e/jenkins/app.sh /usr/local/share/jenkins/app.sh
COPY crates/updatec/e2e/jenkins/install.sh /usr/local/share/jenkins/install.sh
# The HAProxy lifecycle provider (a clean bash state machine) and its launcher — published into the
# release repo by release-server and downloaded at runtime, never a bespoke image. This is the same
# reexec provider proven by scripts/linux-haproxy-e2e.sh.
COPY scripts/haproxy/lifecycle /usr/local/share/haproxy/lifecycle
COPY scripts/haproxy/lib.sh /usr/local/share/haproxy/lib.sh
COPY scripts/haproxy/launch /usr/local/share/haproxy/launch
RUN chmod 0755 /usr/local/bin/release-server /usr/local/bin/run-agent \
    /usr/local/share/haproxy/lifecycle /usr/local/share/haproxy/launch
USER 65532
