{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updated.dev/schemas/provider-set.schema.json",
  "title": "Updated Provider Set",
  "description": "Signed, immutable binding of a deployment to its node reconciler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "reconciler"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:$|\\.))[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "reconciler": { "$ref": "#/$defs/reconciler" }
  },
  "$defs": {
    "reconciler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "args", "timeout_millis"],
      "properties": {
        "artifact": {
          "$ref": "https://updated.dev/schemas/target-reference.schema.json"
        },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 16384 }
        },
        "timeout_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    }
  }
}
