# Copy to deploy.env (ignored by Git). This file is sourced as shell and must
# remain mode 0600 because the Proxmox API token is a secret.

export TF_VAR_proxmox_api_token='terraform@pve!updatedc-chaos=REPLACE_ME'
export UPDATEDC_CHAOS_SSH_KEY='/secure/path/id_ed25519'

# Deployment never resolves these from moving package repositories. Supply the
# exact reviewed artifacts and their lowercase SHA-256 digests.
export UPDATEDC_CHAOS_K3S_BINARY='/secure/path/k3s-v1.35.5+k3s1'
export UPDATEDC_CHAOS_K3S_SHA256='267d18da7b3c837d82283f0588fb9031a8a6ff3c0dac772c260c40852ce515f6'
export UPDATEDC_CHAOS_MESH_CHART='/secure/path/chaos-mesh-2.8.3.tgz'
export UPDATEDC_CHAOS_MESH_CHART_SHA256='c96a2d6490c1fbb0693e18b04e2ab6f60ca45046c64e98ca774f72ac1eaf2a47'
export UPDATEDC_CHAOS_MONITORING_CHART='/secure/path/kube-prometheus-stack-87.21.0.tgz'
export UPDATEDC_CHAOS_MONITORING_CHART_SHA256='05eae98df0ff6c21877a26a4400780e4bbff248bc3b88694ef8d08b273ed6815'

# Site bindings. These defaults match the dedicated lab allocation on
# poweredge-md and may be omitted unless the whole lab moves.
export TF_VAR_proxmox_endpoint='https://10.0.0.206:8006/'
export TF_VAR_proxmox_insecure=true
export TF_VAR_proxmox_node_name='poweredge-md'
export TF_VAR_proxmox_node_address='10.0.0.206'
export TF_VAR_gateway='10.0.0.1'
export TF_VAR_dns_servers='["10.0.0.1"]'
